{
  "name": "mpi-frontend",
  "private": true,
  "version": "2026.11.24-1",
  "description": "MPI",
  "author": "mpi",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --configLoader runner",
    "gen:notices": "node scripts/gen-notices.mjs",
    "prebuild": "node ../scripts/gen-licenses.mjs && node scripts/gen-notices.mjs",
    "build": "tsc -b --noEmit && vite build --configLoader runner && npm run electron:compile",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "electron:compile": "tsc -p tsconfig.electron.json && node scripts/write-cjs-package.mjs",
    "electron:dev": "npm run electron:compile && concurrently -k -n \"vite,electron\" -c \"cyan,magenta\" \"vite --configLoader runner\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "node ../scripts/check-windows-no-apk.mjs --notices && npm run build:renderer && electron-builder --win --publish never",
    "build:renderer": "tsc -b --noEmit && vite build --configLoader runner && npm run electron:compile"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "43.8.12",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.3"
  },
  "build": {
    "buildVersion": "2026.11.24.1",
    "buildNumber": "1",
    "appId": "com.mpi.app",
    "productName": "MPI",
    "afterSign": "scripts/after-pack-alias.cjs",
    "directories": {
      "output": "build_output"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "dist-electron/package.json",
      "package.json",
      "!**/*.map",
      "!**/{test,tests,__tests__}/**/*",
      "!**/*.{spec,test}.{js,cjs,mjs,ts,tsx}"
    ],
    "extraResources": [
      {
        "from": "../dist/data-engine.exe",
        "to": "data-engine.exe"
      },
      {
        "from": "../scripts/ios-tunnel.ps1",
        "to": "ios-tunnel.ps1"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "win": {
      "target": "nsis",
      "executableName": "MPI",
      "icon": "build-assets/icon.ico",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://time.certum.pl"
      },
      "extraResources": [
        {
          "from": "../dist/ENGINE-RUNTIME-NOTICES.txt",
          "to": "ENGINE-RUNTIME-NOTICES.txt"
        }
      ]
    },
    "nsis": {
      "guid": "a6dc989d-674f-532c-aa30-ad0fc0146cfe",
      "artifactName": "MPI Setup ${version}.${ext}"
    },
    "afterPack": "scripts/check-no-android-package.cjs",
    "afterAllArtifactBuild": "scripts/check-windows-installer.cjs",
    "publish": null
  }
}
